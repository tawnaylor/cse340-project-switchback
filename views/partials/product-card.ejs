<article class="card-item">
  <a class="card-image" href="/products/<%= product.id %>" tabindex="-1" aria-hidden="true">
    <% if (product.image_url) { %>
      <img src="<%= product.image_url %>" alt="" loading="lazy" width="400" height="400">
    <% } else { %>
      <div class="image-placeholder">
        <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 74 L60 8 L114 74 Z"/>
          <path d="M30 62 L78 54 L40 44 L70 36"/>
        </svg>
      </div>
    <% } %>
    <% if (!product.in_stock) { %><span class="badge-soldout">Sold out</span><% } %>
  </a>
  <div class="card-body">
    <p class="card-kicker"><%= product.brand_name || product.category_name %></p>
    <h3><a href="/products/<%= product.id %>"><%= product.name %></a></h3>
    <% if (product.review_count > 0) { %>
      <p class="card-rating">
        <span class="stars" aria-label="Rated <%= product.avg_rating %> out of 5"><%= stars(product.avg_rating) %></span>
        <span class="muted">(<%= product.review_count %>)</span>
      </p>
    <% } %>
    <% if (product.terrain.length) { %>
      <ul class="chips">
        <% product.terrain.slice(0, 3).forEach((tag) => { %>
          <li class="chip"><%= tag %></li>
        <% }) %>
      </ul>
    <% } %>
    <p class="card-foot"><strong><%= formatPrice(product.price_cents) %></strong></p>
  </div>
</article>
