<section>
  <h1>Shop trail gear</h1>

  <form action="/products" method="GET" class="filters" role="search">
    <div class="field">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" maxlength="60" placeholder="Shoes, vests, brands" value="<%= filters.q %>">
    </div>

    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All categories</option>
        <% categories.forEach((c) => { %>
          <option value="<%= c.slug %>" <%= filters.category === c.slug ? 'selected' : '' %>><%= c.name %> (<%= c.product_count %>)</option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="terrain">Terrain</label>
      <select id="terrain" name="terrain">
        <option value="">Any terrain</option>
        <% terrains.forEach((t) => { %>
          <option value="<%= t.slug %>" <%= filters.terrain === t.slug ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="brand">Brand</label>
      <select id="brand" name="brand">
        <option value="">All brands</option>
        <% brands.forEach((b) => { %>
          <option value="<%= b.id %>" <%= filters.brandId === b.id ? 'selected' : '' %>><%= b.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="sort">Sort by</label>
      <select id="sort" name="sort">
        <% [['newest', 'Newest'], ['price-asc', 'Price: low to high'], ['price-desc', 'Price: high to low'], ['name', 'Name']].forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>

    <div class="filter-actions">
      <button type="submit" class="btn">Apply</button>
      <a class="btn btn-ghost" href="/products">Clear</a>
    </div>
  </form>

  <p class="muted results-count"><%= total %> <%= total === 1 ? 'product' : 'products' %></p>

  <% if (products.length) { %>
    <div class="grid-4">
      <% products.forEach((product) => { %>
        <%- include('../partials/product-card', { product }) %>
      <% }) %>
    </div>
    <%- include('../partials/pagination') %>
  <% } else { %>
    <p class="empty">No products match those filters. <a href="/products">Clear filters</a></p>
  <% } %>
</section>
