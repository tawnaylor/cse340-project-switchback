<section class="narrow">
  <h1>Create your account</h1>
  <%- include('../partials/errors') %>

  <form action="/register" method="POST" class="form" novalidate>
    <%- include('../partials/csrf') %>

    <div class="field-row">
      <div class="field">
        <label for="firstName">First name</label>
        <input id="firstName" name="firstName" type="text" maxlength="50" required autocomplete="given-name" value="<%= values.firstName || '' %>">
      </div>
      <div class="field">
        <label for="lastName">Last name</label>
        <input id="lastName" name="lastName" type="text" maxlength="50" required autocomplete="family-name" value="<%= values.lastName || '' %>">
      </div>
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" maxlength="255" required autocomplete="email" value="<%= values.email || '' %>">
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" minlength="8" maxlength="72" required autocomplete="new-password">
      <small>At least 8 characters, with a letter and a number.</small>
    </div>

    <div class="field">
      <label for="confirmPassword">Confirm password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password">
    </div>

    <button type="submit" class="btn">Sign up</button>
  </form>

  <p class="muted">Already have an account? <a href="/login">Log in</a></p>
</section>
