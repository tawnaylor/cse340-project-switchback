# Copy this file to .env and fill in the values. Never commit .env.

# Local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/switchback

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# development locally, production on Render
NODE_ENV=development

# Render sets PORT for you. Locally it defaults to 3000.
PORT=3000

# Set to true only when running db scripts from your computer against a
# Render database using its External Database URL.
# DATABASE_SSL=true
